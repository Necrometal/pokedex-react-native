{
  "expo": {
    "name": "PokeNav",
    "slug": "pokedex",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/pokeball-icon.png",
    "scheme": "PokeNav",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.necrometal.pokedex",
      "icon": "./assets/images/pokeball-icon.png"
    },
    "android": {
      "icon": "./assets/images/pokeball-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/pokeball-icon.png",
        "backgroundImage": "./assets/images/pokeball-icon.png",
        "monochromeImage": "./assets/images/pokeball-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.necrometal.pokedex",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/pokeball-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a211a408-53a7-4863-9fe6-974a11e1a900"
      }
    }
  }
}
